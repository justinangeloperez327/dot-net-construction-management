@page "/projects/{ProjectId:guid}/payment-applications"
@attribute [Authorize(Policy = Permissions.PaymentApplications.View)]
@inject GetProjectHandler ProjectReader
@inject ListPaymentApplicationsHandler PaymentApplicationList

<PageTitle>Payment applications</PageTitle>

@if (_project is null)
{
    <h1>Project not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Payment applications</h1>
            <p>@_project.ProjectNumber · @_project.Name</p>
        </div>

        <a href="@($"/projects/{ProjectId}/purchase-orders")">
            Purchase orders
        </a>
    </div>

    <div class="filter-bar">
        <select @bind="_status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<PaymentApplicationStatus>())
            {
                <option value="@status">@FormatStatus(status)</option>
            }
        </select>

        <button type="button" @onclick="ApplyFilterAsync">
            Filter
        </button>
    </div>

    @if (_result is null)
    {
        <p>Loading...</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p>No payment applications found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Application no.</th>
                    <th>PO</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th>Claimed amount</th>
                    <th>Status</th>
                    <th>Created by</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in _result.Items)
                {
                    <tr>
                        <td>@application.ApplicationNumber</td>
                        <td>@application.PurchaseOrderNumber</td>
                        <td>@application.SupplierName</td>
                        <td>@application.ApplicationDate.ToString("dd MMM yyyy")</td>
                        <td>@application.Currency @application.ClaimedAmount.ToString("N2")</td>
                        <td>@FormatStatus(application.Status)</td>
                        <td>@application.CreatedBy</td>
                        <td>
                            <a href="@($"/payment-applications/{application.Id}")">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button type="button"
                    disabled="@(_result.Page <= 1)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <span>
                Page @_result.Page of @_result.TotalPages
                · @_result.TotalCount total
            </span>

            <button type="button"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Application.Projects.ProjectDetails? _project;
    private PaymentApplicationListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        _project = await ProjectReader.HandleAsync(ProjectId);
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(_result.TotalPages, _page + 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        PaymentApplicationStatus? status =
            Enum.TryParse<PaymentApplicationStatus>(
                _status,
                ignoreCase: true,
                out var parsed)
                ? parsed
                : null;

        _result = await PaymentApplicationList.HandleAsync(
            new ListPaymentApplicationsQuery(
                ProjectId,
                status,
                _page));
    }

    private static string FormatStatus(
        PaymentApplicationStatus status) =>
        status == PaymentApplicationStatus.PendingApproval
            ? "Pending approval"
            : status.ToString();
}
