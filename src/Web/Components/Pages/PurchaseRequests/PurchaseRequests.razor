@page "/projects/{ProjectId:guid}/purchase-requests"
@attribute [Authorize(Policy = Permissions.PurchaseRequests.View)]
@inject GetProjectHandler ProjectReader
@inject ListPurchaseRequestsHandler PurchaseRequestList

<PageTitle>Purchase requests</PageTitle>

@if (_project is null)
{
    <h1>Project not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Purchase requests</h1>
            <p>@_project.ProjectNumber · @_project.Name</p>
        </div>

        @if (_project.Status == ProjectStatus.Active)
        {
            <AuthorizeView Policy="@Permissions.PurchaseRequests.Create">
                <Authorized>
                    <a class="button-link"
                       href="@($"/projects/{ProjectId}/purchase-requests/create")">
                        Create purchase request
                    </a>
                </Authorized>
            </AuthorizeView>
        }
    </div>

    <div class="filter-bar">
        <select @bind="_status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<PurchaseRequestStatus>())
            {
                <option value="@status">@FormatStatus(status)</option>
            }
        </select>

        <button type="button" @onclick="ApplyFilterAsync">
            Filter
        </button>
    </div>

    @if (_result is null)
    {
        <p>Loading...</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p>No purchase requests found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>PR no.</th>
                    <th>Title</th>
                    <th>Required by</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th>Requested by</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in _result.Items)
                {
                    <tr>
                        <td>@request.RequestNumber</td>
                        <td>@request.Title</td>
                        <td>@(request.RequiredByDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@request.ItemCount</td>
                        <td>@FormatStatus(request.Status)</td>
                        <td>@request.RequestedBy</td>
                        <td>@request.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <a href="@($"/purchase-requests/{request.Id}")">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button type="button"
                    disabled="@(_result.Page <= 1)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <span>
                Page @_result.Page of @_result.TotalPages
                · @_result.TotalCount total
            </span>

            <button type="button"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Application.Projects.ProjectDetails? _project;
    private PurchaseRequestListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        _project = await ProjectReader.HandleAsync(ProjectId);
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(_result.TotalPages, _page + 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        PurchaseRequestStatus? status =
            Enum.TryParse<PurchaseRequestStatus>(
                _status,
                ignoreCase: true,
                out var parsed)
                ? parsed
                : null;

        _result = await PurchaseRequestList.HandleAsync(
            new ListPurchaseRequestsQuery(
                ProjectId,
                status,
                _page));
    }

    private static string FormatStatus(
        PurchaseRequestStatus status) =>
        status == PurchaseRequestStatus.PendingApproval
            ? "Pending approval"
            : status.ToString();
}
