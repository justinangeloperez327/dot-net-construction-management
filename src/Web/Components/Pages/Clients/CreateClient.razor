@page "/clients/create"
@attribute [Authorize(Policy = Permissions.Clients.Create)]
@inject CreateClientHandler ClientCreator
@inject NavigationManager Navigation

<PageTitle>Create client</PageTitle>

<h1>Create client</h1>

@if (_errors.Count > 0)
{
    <div class="validation-error" role="alert">
        @foreach (var error in _errors)
        {
            <div>@error</div>
        }
    </div>
}

<EditForm Model="_model"
          OnValidSubmit="CreateAsync"
          class="form-grid">
    <DataAnnotationsValidator />

    <label for="name">Client name</label>
    <InputText id="name" @bind-Value="_model.Name" />

    <label for="contact">Contact person</label>
    <InputText id="contact" @bind-Value="_model.ContactPerson" />

    <label for="email">Email</label>
    <InputText id="email"
               type="email"
               @bind-Value="_model.Email" />

    <label for="phone">Phone</label>
    <InputText id="phone" @bind-Value="_model.Phone" />

    <label for="address">Address</label>
    <InputTextArea id="address" @bind-Value="_model.Address" />

    <button type="submit">Create client</button>
</EditForm>

@code {
    private readonly ClientFormModel _model = new();
    private readonly List<string> _errors = [];

    private async Task CreateAsync()
    {
        _errors.Clear();

        var result = await ClientCreator.HandleAsync(
            new CreateClientRequest(
                _model.Name,
                _model.ContactPerson,
                _model.Email,
                _model.Phone,
                _model.Address));

        if (result.Succeeded && result.ClientId is Guid clientId)
        {
            Navigation.NavigateTo($"/clients/{clientId}");
            return;
        }

        _errors.AddRange(result.Errors);
    }
}
