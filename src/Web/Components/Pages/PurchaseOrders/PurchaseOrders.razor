@page "/projects/{ProjectId:guid}/purchase-orders"
@attribute [Authorize(Policy = Permissions.PurchaseOrders.View)]
@inject GetProjectHandler ProjectReader
@inject ListPurchaseOrdersHandler PurchaseOrderList

<PageTitle>Purchase orders</PageTitle>

@if (_project is null)
{
    <h1>Project not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Purchase orders</h1>
            <p>@_project.ProjectNumber · @_project.Name</p>
        </div>

        <AuthorizeView Policy="@Permissions.PurchaseRequests.View">
            <Authorized>
                <a class="button-link"
                   href="@($"/projects/{ProjectId}/purchase-requests")">
                    Create from approved PR
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="filter-bar">
        <select @bind="_status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
            {
                <option value="@status">@FormatStatus(status)</option>
            }
        </select>

        <button type="button" @onclick="ApplyFilterAsync">
            Filter
        </button>
    </div>

    @if (_result is null)
    {
        <p>Loading...</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p>No purchase orders found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>PO no.</th>
                    <th>Supplier</th>
                    <th>Order date</th>
                    <th>Expected delivery</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in _result.Items)
                {
                    <tr>
                        <td>@order.PurchaseOrderNumber</td>
                        <td>@order.SupplierName</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@(order.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@order.Currency @order.GrandTotal.ToString("N2")</td>
                        <td>@FormatStatus(order.Status)</td>
                        <td>
                            <a href="@($"/purchase-orders/{order.Id}")">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button type="button"
                    disabled="@(_result.Page <= 1)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <span>
                Page @_result.Page of @_result.TotalPages
                · @_result.TotalCount total
            </span>

            <button type="button"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Application.Projects.ProjectDetails? _project;
    private PurchaseOrderListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        _project = await ProjectReader.HandleAsync(ProjectId);
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(_result.TotalPages, _page + 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        PurchaseOrderStatus? status =
            Enum.TryParse<PurchaseOrderStatus>(
                _status,
                ignoreCase: true,
                out var parsed)
                ? parsed
                : null;

        _result = await PurchaseOrderList.HandleAsync(
            new ListPurchaseOrdersQuery(
                ProjectId,
                status,
                _page));
    }

    private static string FormatStatus(
        PurchaseOrderStatus status) =>
        status == PurchaseOrderStatus.PendingApproval
            ? "Pending approval"
            : status.ToString();
}
