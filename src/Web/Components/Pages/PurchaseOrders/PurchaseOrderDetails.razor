@page "/purchase-orders/{Id:guid}"
@attribute [Authorize(Policy = Permissions.PurchaseOrders.View)]
@inject GetPurchaseOrderHandler PurchaseOrderReader
@inject GetProjectHandler ProjectReader
@inject ListActiveSuppliersHandler SupplierList
@inject UpdatePurchaseOrderHandler PurchaseOrderUpdater
@inject UpdatePurchaseOrderItemHandler ItemUpdater
@inject RemovePurchaseOrderItemHandler ItemRemover
@inject SubmitPurchaseOrderHandler PurchaseOrderSubmitter
@inject CancelPurchaseOrderHandler PurchaseOrderCanceller
@inject ListPurchaseOrderApproversHandler ApproverList

<PageTitle>Purchase order</PageTitle>

@if (_order is null)
{
    <h1>Purchase order not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>@_order.PurchaseOrderNumber</h1>
            <p>@_order.SupplierName · @FormatStatus(_order.Status)</p>
        </div>

        <div class="page-actions">
            <a class="button-link"
               href="@($"/purchase-requests/{_order.PurchaseRequestId}")">
                Source PR @_order.PurchaseRequestNumber
            </a>

            @if (_order.ApprovalRequestId is Guid approvalId)
            {
                <a class="button-link"
                   href="@($"/approvals/{approvalId}")">
                    Approval
                </a>
            }

            @if (_order.Status == PurchaseOrderStatus.Approved &&
                 _project?.Status == ProjectStatus.Active)
            {
                <AuthorizeView Policy="@Permissions.Deliveries.Create">
                    <Authorized>
                        <a class="button-link"
                           href="@($"/purchase-orders/{Id}/deliveries/create")">
                            Record delivery
                        </a>
                    </Authorized>
                </AuthorizeView>
            }

            @if (_order.Status == PurchaseOrderStatus.Approved)
            {
                <AuthorizeView Policy="@Permissions.PaymentApplications.Create">
                    <Authorized>
                        <a class="button-link"
                           href="@($"/purchase-orders/{Id}/payment-applications/create")">
                            Create payment application
                        </a>
                    </Authorized>
                </AuthorizeView>
            }

            <a href="@($"/projects/{_order.ProjectId}/purchase-orders")">
                Back to purchase orders
            </a>
        </div>
    </div>

    @if (_errors.Count > 0)
    {
        <div class="validation-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="success-message">@_message</p>
    }

    <dl class="details-grid">
        <dt>Status</dt>
        <dd>@FormatStatus(_order.Status)</dd>

        <dt>Supplier</dt>
        <dd>@_order.SupplierName</dd>

        <dt>Order date</dt>
        <dd>@_order.OrderDate.ToString("dd MMM yyyy")</dd>

        <dt>Expected delivery</dt>
        <dd>@(_order.ExpectedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</dd>

        <dt>Created by</dt>
        <dd>@_order.CreatedBy</dd>

        <dt>Created</dt>
        <dd>@_order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>

        <dt>Delivery address</dt>
        <dd>@(_order.DeliveryAddress ?? "—")</dd>

        <dt>Delivery terms</dt>
        <dd>@(_order.DeliveryTerms ?? "—")</dd>

        <dt>Payment terms</dt>
        <dd>@(_order.PaymentTerms ?? "—")</dd>

        <dt>Notes</dt>
        <dd>@(_order.Notes ?? "—")</dd>
    </dl>

    @if (IsEditable)
    {
        <AuthorizeView Policy="@Permissions.PurchaseOrders.Update">
            <Authorized Context="authorizationState">
                <section class="form-section">
                    <h2>Edit purchase order</h2>

                    <EditForm Model="_header"
                              OnValidSubmit="SaveHeaderAsync"
                              class="form-grid"
                              Context="poHeaderEditContext">
                        <DataAnnotationsValidator />

                        <label for="po-number">PO number</label>
                        <InputText id="po-number"
                                   @bind-Value="_header.PurchaseOrderNumber" />
                        <ValidationMessage For="() => _header.PurchaseOrderNumber" />

                        <label for="supplier">Supplier</label>
                        <InputSelect id="supplier"
                                     @bind-Value="_header.SupplierId">
                            @foreach (var supplier in _suppliers)
                            {
                                <option value="@supplier.Id">
                                    @supplier.SupplierCode · @supplier.Name
                                </option>
                            }
                        </InputSelect>

                        <label for="order-date">Order date</label>
                        <InputDate id="order-date"
                                   @bind-Value="_header.OrderDate" />

                        <label for="delivery-date">Expected delivery</label>
                        <InputDate id="delivery-date"
                                   @bind-Value="_header.ExpectedDeliveryDate" />

                        <label for="currency">Currency</label>
                        <InputText id="currency"
                                   @bind-Value="_header.Currency" />
                        <ValidationMessage For="() => _header.Currency" />

                        <label for="delivery-address">Delivery address</label>
                        <InputTextArea id="delivery-address"
                                       @bind-Value="_header.DeliveryAddress" />

                        <label for="delivery-terms">Delivery terms</label>
                        <InputTextArea id="delivery-terms"
                                       @bind-Value="_header.DeliveryTerms" />

                        <label for="payment-terms">Payment terms</label>
                        <InputTextArea id="payment-terms"
                                       @bind-Value="_header.PaymentTerms" />

                        <label for="notes">Notes</label>
                        <InputTextArea id="notes"
                                       @bind-Value="_header.Notes" />

                        <button type="submit">Save PO</button>
                    </EditForm>
                </section>
            </Authorized>
        </AuthorizeView>
    }

    <section class="form-section">
        <h2>Order items</h2>

        @if (_order.Items.Count == 0)
        {
            <p>No items remain in this purchase order.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Unit price</th>
                        <th>Discount %</th>
                        <th>Tax %</th>
                        <th>Total</th>
                        @if (IsEditable)
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _order.Items)
                    {
                        <tr>
                            <td>@item.Description</td>
                            <td>@item.Quantity</td>
                            <td>@item.Unit</td>
                            <td>@_order.Currency @item.UnitPrice.ToString("N4")</td>
                            <td>@item.DiscountPercent.ToString("N2")</td>
                            <td>@item.TaxPercent.ToString("N2")</td>
                            <td>@_order.Currency @item.TotalAmount.ToString("N2")</td>
                            @if (IsEditable)
                            {
                                <td>
                                    <AuthorizeView Policy="@Permissions.PurchaseOrders.Update">
                                        <Authorized>
                                            <button type="button"
                                                    @onclick="() => BeginEditItem(item)">
                                                Edit
                                            </button>
                                            <button type="button"
                                                    class="danger-button"
                                                    @onclick="() => RemoveItemAsync(item.Id)">
                                                Remove
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }

        <dl class="details-grid">
            <dt>Subtotal</dt>
            <dd>@_order.Currency @_order.Subtotal.ToString("N2")</dd>
            <dt>Discount</dt>
            <dd>@_order.Currency @_order.DiscountTotal.ToString("N2")</dd>
            <dt>Tax</dt>
            <dd>@_order.Currency @_order.TaxTotal.ToString("N2")</dd>
            <dt>Grand total</dt>
            <dd><strong>@_order.Currency @_order.GrandTotal.ToString("N2")</strong></dd>
        </dl>

        @if (IsEditable && _editingItemId is not null)
        {
            <AuthorizeView Policy="@Permissions.PurchaseOrders.Update">
                <Authorized Context="authorizationState">
                    <h3>Edit order item</h3>

                    <EditForm Model="_item"
                              OnValidSubmit="SaveItemAsync"
                              class="form-grid"
                              Context="poItemEditContext">
                        <DataAnnotationsValidator />

                        <label for="quantity">Quantity</label>
                        <InputNumber id="quantity"
                                     @bind-Value="_item.Quantity" />

                        <label for="unit-price">Unit price</label>
                        <InputNumber id="unit-price"
                                     @bind-Value="_item.UnitPrice" />

                        <label for="discount">Discount %</label>
                        <InputNumber id="discount"
                                     @bind-Value="_item.DiscountPercent" />

                        <label for="tax">Tax %</label>
                        <InputNumber id="tax"
                                     @bind-Value="_item.TaxPercent" />

                        <label for="remarks">Remarks</label>
                        <InputTextArea id="remarks"
                                       @bind-Value="_item.Remarks" />

                        <div class="page-actions">
                            <button type="submit">Save item</button>
                            <button type="button"
                                    @onclick="ResetItemForm">
                                Cancel edit
                            </button>
                        </div>
                    </EditForm>
                </Authorized>
            </AuthorizeView>
        }
    </section>

    @if (IsEditable &&
         _order.Items.Count > 0 &&
         _order.GrandTotal > 0)
    {
        <AuthorizeView Policy="@Permissions.PurchaseOrders.Submit">
            <Authorized Context="authorizationState">
                <section class="form-section">
                    <h2>Submit for approval</h2>

                    @for (var index = 0; index < _approvalSteps.Count; index++)
                    {
                        var stepIndex = index;

                        <div class="form-grid">
                            <label>Step @(stepIndex + 1) name</label>
                            <input maxlength="150"
                                   @bind="_approvalSteps[stepIndex].Name" />

                            <label>Approver</label>
                            <select @bind="_approvalSteps[stepIndex].ApproverUserId">
                                <option value="@Guid.Empty">Select approver</option>
                                @foreach (var approver in _approvers)
                                {
                                    <option value="@approver.Id">
                                        @approver.Email
                                    </option>
                                }
                            </select>

                            @if (_approvalSteps.Count > 1)
                            {
                                <button type="button"
                                        class="danger-button"
                                        @onclick="() => RemoveApprovalStep(stepIndex)">
                                    Remove step
                                </button>
                            }
                        </div>
                    }

                    <div class="page-actions">
                        <button type="button"
                                @onclick="AddApprovalStep">
                            Add approval step
                        </button>

                        <button type="button"
                                @onclick="SubmitAsync">
                            Submit purchase order
                        </button>
                    </div>
                </section>
            </Authorized>
        </AuthorizeView>
    }
    else if (IsEditable && _order.GrandTotal <= 0)
    {
        <p>Set commercial pricing before submitting the purchase order.</p>
    }

    @if (IsEditable)
    {
        <AuthorizeView Policy="@Permissions.PurchaseOrders.Cancel">
            <Authorized>
                <section class="danger-zone">
                    <h2>Cancel purchase order</h2>
                    <p>Cancelled draft purchase orders remain in procurement history.</p>
                    <button type="button"
                            class="danger-button"
                            @onclick="CancelOrderAsync">
                        Cancel purchase order
                    </button>
                </section>
            </Authorized>
        </AuthorizeView>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Application.PurchaseOrders.PurchaseOrderDetails? _order;
    private Application.Projects.ProjectDetails? _project;
    private IReadOnlyList<SupplierOption> _suppliers = [];
    private IReadOnlyList<UserDirectoryEntry> _approvers = [];
    private readonly PurchaseOrderFormModel _header = new();
    private readonly PurchaseOrderItemFormModel _item = new();
    private readonly List<ApprovalStepFormModel> _approvalSteps =
        [new()];
    private Guid? _editingItemId;
    private readonly List<string> _errors = [];
    private string? _message;

    private bool IsEditable =>
        _project?.Status == ProjectStatus.Active &&
        _order?.Status is PurchaseOrderStatus.Draft
            or PurchaseOrderStatus.Rejected;

    protected override async Task OnParametersSetAsync()
    {
        _suppliers = await SupplierList.HandleAsync();
        _approvers = await ApproverList.HandleAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _order = await PurchaseOrderReader.HandleAsync(Id);

        if (_order is null)
        {
            _project = null;
            return;
        }

        _project = await ProjectReader.HandleAsync(
            _order.ProjectId);

        _header.SupplierId = _order.SupplierId;
        _header.PurchaseOrderNumber = _order.PurchaseOrderNumber;
        _header.OrderDate = _order.OrderDate;
        _header.ExpectedDeliveryDate = _order.ExpectedDeliveryDate;
        _header.Currency = _order.Currency;
        _header.DeliveryAddress = _order.DeliveryAddress;
        _header.DeliveryTerms = _order.DeliveryTerms;
        _header.PaymentTerms = _order.PaymentTerms;
        _header.Notes = _order.Notes;
    }

    private async Task SaveHeaderAsync()
    {
        ClearFeedback();

        var result = await PurchaseOrderUpdater.HandleAsync(
            Id,
            new UpdatePurchaseOrderCommand(
                _header.SupplierId,
                _header.PurchaseOrderNumber,
                _header.OrderDate,
                _header.ExpectedDeliveryDate,
                _header.Currency,
                _header.DeliveryAddress,
                _header.DeliveryTerms,
                _header.PaymentTerms,
                _header.Notes));

        await HandleAsync(result, "Purchase order updated.");
    }

    private void BeginEditItem(
        PurchaseOrderItemDetails item)
    {
        _editingItemId = item.Id;
        _item.Quantity = item.Quantity;
        _item.UnitPrice = item.UnitPrice;
        _item.DiscountPercent = item.DiscountPercent;
        _item.TaxPercent = item.TaxPercent;
        _item.Remarks = item.Remarks;
    }

    private async Task SaveItemAsync()
    {
        if (_editingItemId is not Guid itemId)
        {
            return;
        }

        ClearFeedback();

        var result = await ItemUpdater.HandleAsync(
            Id,
            itemId,
            new UpdatePurchaseOrderItemCommand(
                _item.Quantity,
                _item.UnitPrice,
                _item.DiscountPercent,
                _item.TaxPercent,
                _item.Remarks));

        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors);
            return;
        }

        ResetItemForm();
        _message = "Order item updated.";
        await LoadAsync();
    }

    private async Task RemoveItemAsync(Guid itemId)
    {
        ClearFeedback();

        var result = await ItemRemover.HandleAsync(
            Id,
            itemId);

        await HandleAsync(result, "Order item removed.");
    }

    private async Task SubmitAsync()
    {
        ClearFeedback();

        if (_approvalSteps.Any(step =>
                string.IsNullOrWhiteSpace(step.Name) ||
                step.ApproverUserId == Guid.Empty))
        {
            _errors.Add(
                "Every approval step requires a name and approver.");
            return;
        }

        var result = await PurchaseOrderSubmitter.HandleAsync(
            Id,
            new SubmitPurchaseOrderCommand(
                _approvalSteps
                    .Select(step => new ApprovalStepInput(
                        step.Name,
                        step.ApproverUserId))
                    .ToArray()));

        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors);
            return;
        }

        _message = "Purchase order submitted for approval.";
        await LoadAsync();
    }

    private async Task CancelOrderAsync()
    {
        ClearFeedback();

        var result = await PurchaseOrderCanceller.HandleAsync(Id);

        await HandleAsync(
            result,
            "Purchase order cancelled.");
    }

    private async Task HandleAsync(
        PurchaseOrderActionResult result,
        string message)
    {
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors);
            return;
        }

        _message = message;
        await LoadAsync();
    }

    private void AddApprovalStep()
    {
        _approvalSteps.Add(new ApprovalStepFormModel());
    }

    private void RemoveApprovalStep(int index)
    {
        if (_approvalSteps.Count > 1)
        {
            _approvalSteps.RemoveAt(index);
        }
    }

    private void ResetItemForm()
    {
        _editingItemId = null;
        _item.Quantity = 1;
        _item.UnitPrice = 0;
        _item.DiscountPercent = 0;
        _item.TaxPercent = 0;
        _item.Remarks = null;
    }

    private void ClearFeedback()
    {
        _errors.Clear();
        _message = null;
    }

    private static string FormatStatus(
        PurchaseOrderStatus status) =>
        status == PurchaseOrderStatus.PendingApproval
            ? "Pending approval"
            : status.ToString();

    private sealed class PurchaseOrderFormModel
    {
        public Guid SupplierId { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(100)]
        public string PurchaseOrderNumber { get; set; } = string.Empty;

        public DateOnly OrderDate { get; set; }

        public DateOnly? ExpectedDeliveryDate { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(
            3,
            MinimumLength = 3)]
        public string Currency { get; set; } = "AED";

        [System.ComponentModel.DataAnnotations.StringLength(1000)]
        public string? DeliveryAddress { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(1000)]
        public string? DeliveryTerms { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(1000)]
        public string? PaymentTerms { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(2000)]
        public string? Notes { get; set; }
    }

    private sealed class PurchaseOrderItemFormModel
    {
        [System.ComponentModel.DataAnnotations.Range(
            typeof(decimal),
            "0.001",
            "999999999999999.999")]
        public decimal Quantity { get; set; } = 1;

        [System.ComponentModel.DataAnnotations.Range(
            typeof(decimal),
            "0",
            "99999999999999.9999")]
        public decimal UnitPrice { get; set; }

        [System.ComponentModel.DataAnnotations.Range(
            typeof(decimal),
            "0",
            "100")]
        public decimal DiscountPercent { get; set; }

        [System.ComponentModel.DataAnnotations.Range(
            typeof(decimal),
            "0",
            "100")]
        public decimal TaxPercent { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(1000)]
        public string? Remarks { get; set; }
    }

    private sealed class ApprovalStepFormModel
    {
        public string Name { get; set; } = string.Empty;

        public Guid ApproverUserId { get; set; }
    }
}
