@page "/admin/users"
@attribute [Authorize(Policy = Permissions.Users.View)]
@inject IUserAdministration Users

<PageTitle>Users</PageTitle>

<div class="page-heading">
    <div>
        <h1>Users</h1>
        <p>Manage application accounts and access.</p>
    </div>

    <AuthorizeView Policy="@Permissions.Users.Create">
        <Authorized>
            <a class="button-link" href="/admin/users/create">
                Create user
            </a>
        </Authorized>
    </AuthorizeView>
</div>

@if (_users is null)
{
    <p>Loading...</p>
}
else if (_users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in _users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@(user.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a href="@($"/admin/users/{user.Id}")">
                            Manage
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<UserSummary>? _users;

    protected override async Task OnInitializedAsync()
    {
        _users = await Users.ListAsync();
    }
}
