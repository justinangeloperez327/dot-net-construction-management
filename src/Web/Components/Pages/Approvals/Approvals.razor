@page "/approvals"
@attribute [Authorize(Policy = Permissions.Approvals.View)]
@inject ListApprovalRequestsHandler ApprovalList

<PageTitle>Approvals</PageTitle>

<div class="page-heading">
    <div>
        <h1>Approvals</h1>
        <p>Requests you created or are assigned to approve.</p>
    </div>
</div>

<div class="filter-bar">
    <select @bind="_status">
        <option value="">All statuses</option>
        @foreach (var status in Enum.GetValues<ApprovalRequestStatus>())
        {
            <option value="@status">@status</option>
        }
    </select>

    <button type="button" @onclick="ApplyFilterAsync">
        Filter
    </button>
</div>

@if (_result is null)
{
    <p>Loading...</p>
}
else if (_result.Items.Count == 0)
{
    <p>No approval requests found.</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Title</th>
                <th>Type</th>
                <th>Status</th>
                <th>Current step</th>
                <th>Requested by</th>
                <th>Requested</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in _result.Items)
            {
                <tr>
                    <td>@request.Reference</td>
                    <td>@request.Title</td>
                    <td>@request.SubjectType</td>
                    <td>
                        @request.Status
                        @if (request.NeedsMyDecision)
                        {
                            <strong> · Action required</strong>
                        }
                    </td>
                    <td>@(request.CurrentStepName ?? "—")</td>
                    <td>@request.RequestedBy</td>
                    <td>@request.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <a href="@($"/approvals/{request.Id}")">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination">
        <button type="button"
                disabled="@(_result.Page <= 1)"
                @onclick="PreviousPageAsync">
            Previous
        </button>

        <span>
            Page @_result.Page of @_result.TotalPages
            · @_result.TotalCount total
        </span>

        <button type="button"
                disabled="@(_result.Page >= _result.TotalPages)"
                @onclick="NextPageAsync">
            Next
        </button>
    </div>
}

@code {
    private ApprovalRequestListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(
            _result.TotalPages,
            _page + 1);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        ApprovalRequestStatus? status =
            Enum.TryParse<ApprovalRequestStatus>(
                _status,
                ignoreCase: true,
                out var parsed)
                ? parsed
                : null;

        _result = await ApprovalList.HandleAsync(
            new ListApprovalRequestsQuery(
                status,
                _page));
    }
}
