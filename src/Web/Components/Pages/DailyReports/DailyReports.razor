@page "/projects/{ProjectId:guid}/daily-reports"
@attribute [Authorize(Policy = Permissions.DailyReports.View)]
@inject GetProjectHandler ProjectReader
@inject ListDailyReportsHandler ReportList

<PageTitle>Daily site reports</PageTitle>

@if (_project is null)
{
    <h1>Project not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Daily site reports</h1>
            <p>@_project.ProjectNumber · @_project.Name</p>
        </div>

        @if (_project.Status == ProjectStatus.Active)
        {
            <AuthorizeView Policy="@Permissions.DailyReports.Create">
                <Authorized>
                    <a class="button-link"
                       href="@($"/projects/{ProjectId}/daily-reports/create")">
                        Create report
                    </a>
                </Authorized>
            </AuthorizeView>
        }
    </div>

    <div class="filter-bar">
        <select @bind="_status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<DailyReportStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>

        <button type="button" @onclick="ApplyFilterAsync">
            Filter
        </button>
    </div>

    @if (_result is null)
    {
        <p>Loading...</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p>No daily reports found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Prepared by</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in _result.Items)
                {
                    <tr>
                        <td>@report.ReportDate.ToString("dd MMM yyyy")</td>
                        <td>@report.PreparedBy</td>
                        <td>@report.Status</td>
                        <td>@(report.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td>
                            <a href="@($"/daily-reports/{report.Id}")">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button type="button"
                    disabled="@(_result.Page <= 1)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <span>
                Page @_result.Page of @_result.TotalPages
                · @_result.TotalCount total
            </span>

            <button type="button"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Application.Projects.ProjectDetails? _project;
    private DailyReportListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        _project = await ProjectReader.HandleAsync(ProjectId);
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(_result.TotalPages, _page + 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        DailyReportStatus? status = Enum.TryParse<DailyReportStatus>(
            _status,
            ignoreCase: true,
            out var parsed)
            ? parsed
            : null;

        _result = await ReportList.HandleAsync(
            new ListDailyReportsRequest(
                ProjectId,
                status,
                _page));
    }
}
