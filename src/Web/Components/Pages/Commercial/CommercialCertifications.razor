@page "/projects/{ProjectId:guid}/commercial-certifications"
@attribute [Authorize(Policy = Permissions.CommercialCertifications.View)]
@inject GetProjectHandler ProjectReader
@inject ListCommercialCertificationsHandler CertificationList

<PageTitle>Commercial certifications</PageTitle>

@if (_project is null)
{
    <h1>Project not found</h1>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Commercial certifications</h1>
            <p>@_project.ProjectNumber · @_project.Name</p>
        </div>

        <a href="@($"/projects/{ProjectId}/payment-applications")">
            Payment applications
        </a>
    </div>

    <div class="filter-bar">
        <select @bind="_status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<CommercialCertificationStatus>())
            {
                <option value="@status">@FormatStatus(status)</option>
            }
        </select>

        <button type="button" @onclick="ApplyFilterAsync">
            Filter
        </button>
    </div>

    @if (_result is null)
    {
        <p>Loading...</p>
    }
    else if (_result.Items.Count == 0)
    {
        <p>No commercial certifications found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Certificate</th>
                    <th>Payment application</th>
                    <th>PO</th>
                    <th>Supplier</th>
                    <th>Date</th>
                    <th>Claimed</th>
                    <th>Certified</th>
                    <th>Payable</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _result.Items)
                {
                    <tr>
                        <td>@item.CertificateNumber</td>
                        <td>@item.PaymentApplicationNumber</td>
                        <td>@item.PurchaseOrderNumber</td>
                        <td>@item.SupplierName</td>
                        <td>@item.CertificateDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Currency @item.ClaimedAmount.ToString("N2")</td>
                        <td>@item.Currency @item.CertifiedAmount.ToString("N2")</td>
                        <td>@item.Currency @item.PayableAmount.ToString("N2")</td>
                        <td>@FormatStatus(item.Status)</td>
                        <td>
                            <a href="@($"/commercial-certifications/{item.Id}")">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination">
            <button type="button"
                    disabled="@(_result.Page <= 1)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <span>
                Page @_result.Page of @_result.TotalPages
                · @_result.TotalCount total
            </span>

            <button type="button"
                    disabled="@(_result.Page >= _result.TotalPages)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private Application.Projects.ProjectDetails? _project;
    private CommercialCertificationListResult? _result;
    private string _status = string.Empty;
    private int _page = 1;

    protected override async Task OnParametersSetAsync()
    {
        _project = await ProjectReader.HandleAsync(ProjectId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CommercialCertificationStatus? status =
            Enum.TryParse<CommercialCertificationStatus>(
                _status,
                true,
                out var parsed)
                ? parsed
                : null;

        _result = await CertificationList.HandleAsync(
            new ListCommercialCertificationsQuery(
                ProjectId,
                status,
                _page));
    }

    private async Task ApplyFilterAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_result is null)
        {
            return;
        }

        _page = Math.Min(_result.TotalPages, _page + 1);
        await LoadAsync();
    }

    private static string FormatStatus(
        CommercialCertificationStatus status) =>
        status == CommercialCertificationStatus.PendingApproval
            ? "Pending approval"
            : status.ToString();
}
